# ============================================================================
# Camarita - configuración
# Copia este archivo a .env y edítalo:
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Interfaz
# ---------------------------------------------------------------------------
# Puerto del host donde se publica la interfaz.
CAMARITA_PORT=18080

# Puerto del host para WebRTC (solo si activas WebRTC más abajo).
CAMARITA_WEBRTC_PORT=8555

# Autenticación básica de la interfaz. CAMBIA LA CONTRASEÑA.
# Si dejas CAMARITA_USER vacío, la interfaz no pedirá autenticación.
CAMARITA_USER=admin
CAMARITA_PASS=cambia-esta-clave

CAMARITA_TITLE=Camarita
CAMARITA_SUBTITLE=Cámaras IP en directo · sin conversión

# Calidad inicial: auto | hd | sd
CAMARITA_DEFAULT_QUALITY=auto

# Tecnología de reproducción, separada por comas:
#   mse,hls          recomendado: estable, sin conversión, funciona con Docker.
#   webrtc,mse,hls   menor latencia, requiere configurar CAMARITA_WEBRTC_CANDIDATES.
#   mse,hls,mjpeg    último recurso (mjpeg puede transcodificar; evítalo).
CAMARITA_PLAYER_MODE=mse,hls

# Si usas WebRTC dentro de Docker, indica aquí la IP LAN del host y el puerto
# publicado de WebRTC. Sin esto, WebRTC no conectará desde la red local.
#CAMARITA_WEBRTC_CANDIDATES=192.168.1.10:8555

# Umbrales de ancho de banda (Mbps) usados por la calidad automática.
# Ajusta estos valores al bitrate real de tus streams principal/substream.
CAMARITA_MAIN_MBPS=4
CAMARITA_SUB_MBPS=0.6

# Margen de seguridad (0.1 - 1.0). 0.7 = usar como máximo el 70% del ancho
# de banda medido para evitar cortes.
CAMARITA_BANDWIDTH_SAFETY=0.7

# ---------------------------------------------------------------------------
# Cámaras
# ---------------------------------------------------------------------------
# Cada cámara usa el prefijo CAM<N>_ y N puede ir de 1 a 32.
#
# Formas de configurar la URL:
#   A) IP + usuario + contraseña + puerto + marca (se construye la URL).
#   B) CAM<N>_URL con la URL completa (rtsp://, http://, onvif://...).
#   C) CAM<N>_MAIN con una ruta (ej. /Streaming/Channels/101) usando la IP.
#
# Si indicas CAM<N>_URL, tiene prioridad sobre IP/ruta/marca.
# CAM<N>_SUB permite forzar el substream; CAM<N>_SUB= (vacío) lo desactiva.
#
# Consejo: entrecomilla con comillas simples los valores que contengan #, $,
# espacios o caracteres especiales, por ejemplo:
#   CAM1_PASS='mi#clave$rara'
# ---------------------------------------------------------------------------

# --- Cámara 1: Ezviz -------------------------------------------------------
# Activa RTSP en la app de Ezviz. El usuario suele ser "admin" y la
# contraseña el código de verificación del dispositivo.
#CAM1_NAME=Salón
#CAM1_BRAND=ezviz
#CAM1_IP=192.168.1.51
#CAM1_PORT=554
#CAM1_USER=admin
#CAM1_PASS=CODIGO_DE_VERIFICACION
#CAM1_MAIN=/Streaming/Channels/101
#CAM1_SUB=/Streaming/Channels/102

# --- Cámara 2: Yoosee ------------------------------------------------------
#CAM2_NAME=Patio
#CAM2_BRAND=yoosee
#CAM2_IP=192.168.1.52
#CAM2_PORT=554
#CAM2_USER=admin
#CAM2_PASS=12345678
#CAM2_MAIN=/onvif1
#CAM2_SUB=/onvif2

# --- Cámara 3: Eufy --------------------------------------------------------
# La mayoría de cámaras Eufy no exponen RTSP directo. Si usas HomeBase con
# RTSP habilitado (o el add-on Eufy Security), usa la URL exacta que te
# proporcione. El puerto suele ser 8554.
#CAM3_NAME=Puerta
#CAM3_BRAND=eufy
#CAM3_IP=192.168.1.53
#CAM3_PORT=8554
#CAM3_USER=usuario_rtsp
#CAM3_PASS=clave_rtsp
#CAM3_URL=rtsp://usuario_rtsp:clave_rtsp@192.168.1.53:8554/live0
# Sin substream por defecto:
#CAM3_SUB=

# --- Cámara 4: Hikvision ---------------------------------------------------
#CAM4_NAME=Garaje
#CAM4_BRAND=hikvision
#CAM4_IP=192.168.1.54
#CAM4_PORT=554
#CAM4_USER=admin
#CAM4_PASS=TU_CLAVE
#CAM4_MAIN=/Streaming/Channels/101
#CAM4_SUB=/Streaming/Channels/102

# --- Ejemplo con URL completa ---------------------------------------------
#CAM5_NAME=Cámara URL
#CAM5_BRAND=generic
#CAM5_URL=rtsp://usuario:clave@192.168.1.55:554/ruta/al/stream
#CAM5_SUB_URL=rtsp://usuario:clave@192.168.1.55:554/ruta/al/substream

# --- Ajustes opcionales por cámara ----------------------------------------
# Prioridad para la calidad automática (mayor = se queda en HD antes).
#CAM1_PRIORITY=10
#CAM1_MAIN_MBPS=6
#CAM1_SUB_MBPS=0.5
# Desactivar una cámara sin borrar su configuración:
#CAM1_ENABLED=false

# Zona horaria del contenedor.
TZ=Europe/Madrid
